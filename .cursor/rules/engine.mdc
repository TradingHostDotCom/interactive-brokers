### Scan Options by Delta and DTE

```python
def find_options_by_delta(symbol, right, target_delta, target_dte):
    """Find options closest to target delta and DTE."""
    contract = Stock(symbol, 'SMART', 'USD')
    ib.qualifyContracts(contract)

    chains = ib.reqSecDefOptParams(symbol, '', 'STK', contract.conId)
    chain = next(c for c in chains if c.exchange == 'SMART')

    target_date = datetime.now() + timedelta(days=target_dte)
    expiry = min(chain.expirations, key=lambda x: abs(
        datetime.strptime(x, '%Y%m%d') - target_date
    ))

    options = [
        Option(symbol, expiry, strike, right, 'SMART')
        for strike in chain.strikes
    ]
    ib.qualifyContracts(*options)
    tickers = ib.reqTickers(*options)
    ib.sleep(3)

    best = min(
        (t for t in tickers if t.modelGreeks and t.modelGreeks.delta),
        key=lambda t: abs(abs(t.modelGreeks.delta) - abs(target_delta)),
    )
    return best
```

